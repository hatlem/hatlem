# Kopier til .env (eller sett i Railway/Render) og fyll inn.
PORT=4830
BIRTHDAY_NAME=Andreas
# PARTY_TITLE="Andreas fyller 40!"
# Offentlig adresse appen nås på, med sti hvis den ligger under en sti.
# Brukes i QR-kodene og til webhooks. Stien (/bursdag) blir automatisk BASE_PATH.
PUBLIC_URL=https://andreashatlem.no/bursdag
# BASE_PATH=/bursdag   (overstyrer stien fra PUBLIC_URL)
# Nøkkel for /admin (godkjenning, høydepunkt, finale)
ADMIN_KEY=bytt-meg
# Start med «godkjenn før visning» skrudd på (kan også skrus av/på i /admin)
GODKJENNING=1

# Higgsfield (https://cloud.higgsfield.ai -> API keys). Format: key_id:key_secret
HF_KEY=
# Modell for bilde-til-video (standard: Kling 3.0 Standard, stille), og ekstra argumenter som JSON
HF_VIDEO_MODEL=kling-video/v3.0/std/image-to-video
# HF_VIDEO_EXTRA={"sound":"off"}
# HF_IMAGE_FIELD=image_url
# HF_PROMPT_FIELD=prompt
# HF_DURATION_FIELD=duration
# Sekunder per film. Maks 15 uansett hva som settes her (kostnad og ventetid).
VIDEO_SECONDS=5
# Bildefiks før videoen: lyset rettes opp og tømmerhytta byttes med en bakgrunn som passer effekten.
# Standard: Qwen Image 3 Edit. Sett tom (HF_IMAGE_MODEL=) for å hoppe over steget.
HF_IMAGE_MODEL=alibaba/qwen-image-3/edit
# HF_IMAGE_EXTRA={"resolution":"1k"}
# HF_IMAGE_INPUT_FIELD=image_urls
# Egne klipp (/klipp) kuttes alltid til 15 sekunder og kodes om med ffmpeg.
# Filmene vises frem og tilbake (ping-pong) på skjermen. Krever ffmpeg. PINGPONG=0 skrur det av.
# PINGPONG=1
# Antall videoer Higgsfield-kontoen kan lage samtidig (Creator: 8). Resten venter i appens egen kø.
HF_MAX_CONCURRENT=8
# Filmformat: 16:9 fyller skjermen (bildefiksen lager bredt bilde). «auto» følger mobilbildet.
VIDEO_ASPECT=16:9
# Snittid per video i minutter, brukes til «ca. X min» for gjester i kø
# AVG_VIDEO_MIN=2

# Finale: lipsync-modell hos Higgsfield (finn modellstien i cloud.higgsfield.ai, modellen heter «Sync Lipsync 3»)
# HF_LIPSYNC_MODEL=
# HF_LIPSYNC_VIDEO_FIELD=video_url
# HF_LIPSYNC_AUDIO_FIELD=audio_url
# HF_LIPSYNC_EXTRA={"sync_mode":"bounce"}
# Sangen kuttes til så mange sekunder før lipsync (sparer kreditter)
FINALE_SECONDS=60

# Suno via sunoapi.org (eller api.box: SUNO_BASE_URL=https://api.api.box)
SUNO_API_KEY=
SUNO_BASE_URL=https://api.sunoapi.org
SUNO_MODEL=V4_5
# Antall sanger Suno-kontoen kan lage samtidig (resten venter i appens kø)
SUNO_MAX_CONCURRENT=5
# AVG_SONG_MIN=3

# Sekunder per quizspørsmål
# QUIZ_SECONDS=20

# Sperrer så kredittene ikke går tomt
MAX_JOBS_TOTAL=400
MAX_PER_DEVICE=8
